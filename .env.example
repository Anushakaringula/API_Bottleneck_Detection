# Copy to .env and edit if needed:  cp .env.example .env
# Plain KEY=value lines only (Node's --env-file does not expand ${VAR} references).
# Leave a value empty to use the default.

# Target API
PORT=3000
METRICS_PORT=9464
# Optional fallback run ID when a request carries no X-Experiment-Run-Id header
EXPERIMENT_RUN_ID=
# 1 enables the /__calib/noop, /__calib/sleep and /__calib/cpu endpoints (client calibration)
ABR_CALIBRATION=

# Data locations. Defaults are under <repo>/data; set these only to redirect output
# (for example, the tests point them at temporary folders).
ABR_DATA_DIR=
# default: $ABR_DATA_DIR/raw/spans/otel-spans.jsonl
ABR_SPAN_FILE=
# Per-run span copies (<run-id>.jsonl). default: <folder of ABR_SPAN_FILE>/runs
ABR_SPAN_RUN_DIR=
# default: $ABR_DATA_DIR/raw/spans/telemetry.csv
ABR_TELEMETRY_CSV=
# Runtime samples (event-loop delay, GC, CPU, heap). default: $ABR_DATA_DIR/raw/runtime/runtime-metrics.jsonl
ABR_RUNTIME_FILE=
# Sampling window in milliseconds; 0 disables runtime sampling. default: 1000
ABR_RUNTIME_SAMPLE_MS=
# default: $ABR_DATA_DIR/raw/experiments
ABR_EXPERIMENTS_DIR=
# default: $ABR_DATA_DIR/processed
ABR_ANALYSIS_DIR=

# Python interpreter used by the scripts. default: first of python3, python that runs 3.10+
ABR_PYTHON=

# Environment profile (Phase 3.5C). Two profiles, same code:
#   lab    .env.lab  local PostgreSQL + Redis (infrastructure/); ALL measured experiments
#   cloud  .env      Neon + Redis Cloud; application use and demo only
# Copy .env.lab.example to .env.lab for the lab. Put real cloud values only in .env (git-ignored).
ABR_ENV_PROFILE=cloud

# Database and cache. scripts/env.sh parses (does not execute) the file; quotes are optional.
# PostgreSQL for application connections (Neon: the "-pooler" endpoint)
DATABASE_URL=
# PostgreSQL for migrations and seeding (Neon: the direct endpoint, host without "-pooler")
DATABASE_URL_UNPOOLED=
# Redis (Redis Cloud: redis://default:<password>@<host>:<port>)
REDIS_URL=
