{
  "name": "heldout",
  "description": "Held-out session (Phase 3.5D-2), experiments/protocol.md v1: run on a different day than the main campaign, own seed; analysed only once, for the final evaluation. Healthy 8 x 3, 22 fault conditions x 2 = 68 runs.",
  "random_seed": 2026111999,
  "seed_scale": "large",
  "workload": {
    "load_model": "open",
    "arrival_process": "poisson",
    "request_rate_per_second": 5,
    "duration_seconds": 30,
    "warmup_requests": 20,
    "concurrency": 50,
    "timeout_seconds": 30,
    "span_wait_seconds": 15
  },
  "operation_workload": {
    "reports": {
      "request_rate_per_second": 0.5,
      "warmup_requests": 3,
      "duration_seconds": 60
    }
  },
  "require_clean_git": true,
  "discard_warmup_runs": 1,
  "rerun_excluded": true,
  "apply_exclusions": true,
  "exclusion": {
    "require_complete_correlation": true,
    "max_failed_fraction": 0.01,
    "max_send_lag_p99_ms": 10.0,
    "require_ac_power": true
  },
  "conditions": [
    {
      "operation": "users.list",
      "variants": [
        "healthy"
      ],
      "repeats": 3
    },
    {
      "operation": "users.get",
